# Скопируй в .env: cp .env.example .env
# Локальная БД: сначала подними сервисы в корне репо — docker compose up -d
#   Тогда логин/пароль/БД по умолчанию: quasar / quasar / quasar (см. docker-compose.yml)

# Сервер
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# PostgreSQL (Prisma) — host localhost, порт 5437
DATABASE_URL=postgresql://quasar:quasar@localhost:5437/quasar?schema=public

# Redis (сессии, кэш, лимиты) — порт 6379
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars

# Шифрование токенов интеграций (AES-256, 32 байта в base64 или hex — реализация на бэкенде)
ENCRYPTION_KEY=change-me-32-byte-key-for-aes

# ЮКасса (Россия)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Stripe (международные платежи)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
