# Скопируй в корень репо: cp .env.example .env
# Эти переменные подставляет docker compose (см. docker-compose.yml).
# Значения по умолчанию совпадают с backend/.env.example (пользователь quasar, порт 5437).

POSTGRES_USER=quasar
POSTGRES_PASSWORD=quasar
POSTGRES_DB=quasar
POSTGRES_PORT=5437
REDIS_PORT=6379
